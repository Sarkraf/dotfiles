# Get External IP / Internet Speed
alias myip="curl https://ipinfo.io/json" # or /ip for plain-text ip
alias speedtest="curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python3 -"

# Quickly serve the current directory as HTTP
alias serve='ruby -run -e httpd . -p 8000' # Or python -m SimpleHTTPServer :)

# NOTE: On Q3 2021, Le Wagon decided to change the Web Dev curriculum default text editor
alias stt="echo 'Launching VS Code instead of Sublime Text... (cf ~/.aliases)' && code ."

alias maj="sudo apt-get update && sudo apt-get upgrade"

alias zshrc="code ~/.zshrc"
alias aliases="code ~/.aliases"

alias rs="rails s"
alias gph="gp heroku master"


alias cx="code ."

# Pour utiliser une version spécifique de rails dans un dossier
alias ici="bundle exec"

# Docker compose
alias n8n-up="docker compose -f ~/n8n/compose.yaml up -d"
alias n8n-down="docker compose -f ~/n8n/compose.yaml down"
alias n8n-logs="docker compose -f ~/n8n/compose.yaml logs -f"
